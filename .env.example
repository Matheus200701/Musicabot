# ============================================================
# FlaviMusic — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA suba o arquivo ".env" real (com valores reais) para o
# GitHub, Discloud ou qualquer lugar público — apenas este exemplo.
# ============================================================

# --- Bot (obrigatório) ---
# Token do bot: https://discord.com/developers/applications -> seu app -> Bot -> Reset Token
DISCORD_TOKEN=coloque_seu_token_aqui

# Prefixo para comandos de texto legados (a maioria dos comandos agora é / slash)
PREFIX=!

# --- Painel Web ---
WEB_PANEL_ATIVO=true
WEB_PANEL_HOST=0.0.0.0
WEB_PANEL_PORT=8000

# Chave usada para assinar o cookie de sessão do painel. Gere uma aleatória, ex:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WEB_SESSION_SECRET=troque_por_uma_chave_aleatoria_longa

# "true" apenas se o painel for servido por HTTPS (ex: detrás de um proxy com certificado)
WEB_COOKIE_HTTPS_ONLY=false

# --- OAuth2 do Discord (necessário para o login no painel web) ---
# Crie em https://discord.com/developers/applications -> seu app -> OAuth2
#   Client ID e Client Secret ficam na aba "OAuth2 -> General"
#   Em "Redirects", adicione exatamente a mesma URL de DISCORD_REDIRECT_URI abaixo
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Spotify (opcional — sem isso, links do Spotify não funcionam) ---
# Crie um app gratuito em https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
